generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  schedules Schedule[]
  tasks     Task[]
}

model Schedule {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseName String
  dayOfWeek  String
  startTime  String
  endTime    String
  room       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Task {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  deadline    DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
